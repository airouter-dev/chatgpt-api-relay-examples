AI_ROUTER_X402_BASE_URL=https://api.ai-router.dev
AI_ROUTER_X402_MODE=probe
AI_ROUTER_X402_ENDPOINT=generations
AI_ROUTER_X402_MODEL=gpt-image-2
AI_ROUTER_X402_PROMPT=A small red fox under a moonlit sky
